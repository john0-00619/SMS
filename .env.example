# Server
PORT=8080
GEMINI_API_KEY=
# Optional: Firebase Admin (JSON string or base64). If absent, auth verification runs in lenient mode.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=
# Comma-separated allowed origins for CORS (production)
ALLOWED_ORIGINS=http://localhost:5173
# Max upload MB
MAX_UPLOAD_MB=50

# Client (Vite) — copy these into client/.env as well or set in hosting env
VITE_API_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
